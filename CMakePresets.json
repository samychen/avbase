{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "AVBASE_BUILD_TESTS": "ON",
        "AVBASE_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AVBASE_ENABLE_FFMPEG": "ON",
        "AVBASE_STRICT_WARNINGS": "ON",
        "AVBASE_WERROR": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AVBASE_ENABLE_LTO": "ON",
        "AVBASE_ENABLE_DCHECK": "OFF",
        "AVBASE_BUILD_TESTS": "OFF",
        "AVBASE_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "no-ffmpeg",
      "inherits": "base",
      "displayName": "Core only - no FFmpeg needed",
      "cacheVariables": {
        "AVBASE_ENABLE_FFMPEG": "OFF"
      }
    },
    {
      "name": "ffmpeg",
      "inherits": "default",
      "displayName": "System FFmpeg (distro packages), no window system",
      "cacheVariables": {
        "AVBASE_ENABLE_FFMPEG": "ON"
      }
    },
    {
      "name": "linux-sdl2",
      "inherits": "default",
      "cacheVariables": {
        "AVBASE_ENABLE_FFMPEG": "ON",
        "AVBASE_ENABLE_SDL2": "ON",
        "AVBASE_ENABLE_LINUX_NATIVE": "OFF"
      }
    },
    {
      "name": "linux-native",
      "inherits": "default",
      "cacheVariables": {
        "AVBASE_ENABLE_LINUX_NATIVE": "ON",
        "AVBASE_ENABLE_SDL2": "OFF"
      }
    },
    {
      "name": "linux-all",
      "inherits": "default",
      "cacheVariables": {
        "AVBASE_ENABLE_LINUX_NATIVE": "ON",
        "AVBASE_ENABLE_SDL2": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "cacheVariables": {
        "AVBASE_SANITIZERS": "address;undefined",
        "AVBASE_WERROR": "OFF"
      }
    },
    {
      "name": "tsan",
      "inherits": "debug",
      "cacheVariables": {
        "AVBASE_SANITIZERS": "thread",
        "AVBASE_WERROR": "OFF"
      }
    },
    {
      "name": "ubsan",
      "inherits": "debug",
      "cacheVariables": {
        "AVBASE_SANITIZERS": "undefined",
        "AVBASE_WERROR": "OFF"
      }
    },
    {
      "name": "coverage",
      "inherits": "debug",
      "cacheVariables": {
        "AVBASE_COVERAGE": "ON",
        "AVBASE_WERROR": "OFF"
      }
    },
    {
      "name": "android-arm64",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-21",
        "ANDROID_STL": "c++_shared",
        "AVBASE_ENABLE_ANDROID": "ON",
        "AVBASE_ENABLE_FFMPEG": "ON",
        "AVBASE_FFMPEG_ROOT": "${sourceDir}/prebuilt/ffmpeg/android/arm64-v8a",
        "AVBASE_BUILD_TESTS": "OFF",
        "AVBASE_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "linux-ffmpeg711",
      "inherits": "default",
      "displayName": "FFmpeg 7.1.1 pinned via AVBASE_FFMPEG_ROOT",
      "cacheVariables": {
        "AVBASE_ENABLE_FFMPEG": "ON",
        "AVBASE_FFMPEG_ROOT": "$env{AVBASE_FFMPEG_ROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "no-ffmpeg",
      "configurePreset": "no-ffmpeg"
    },
    {
      "name": "ffmpeg",
      "configurePreset": "ffmpeg"
    },
    {
      "name": "linux-sdl2",
      "configurePreset": "linux-sdl2",
      "targets": [
        "play_sdl2"
      ]
    },
    {
      "name": "linux-native",
      "configurePreset": "linux-native",
      "targets": [
        "play_native"
      ]
    },
    {
      "name": "linux-all",
      "configurePreset": "linux-all"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "linux-ffmpeg711",
      "configurePreset": "linux-ffmpeg711"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false,
        "jobs": 8
      }
    },
    {
      "name": "no-ffmpeg",
      "configurePreset": "no-ffmpeg",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "needs-ffmpeg"
        }
      }
    },
    {
      "name": "ffmpeg",
      "configurePreset": "ffmpeg",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "no-tsan"
        }
      }
    }
  ]
}
