# find_package(avbase) config, generated by cmake/AvbaseInstall.cmake.
#
# @PACKAGE_INIT@ expands to the relocatable path helpers CMake needs; the
# FFmpeg requirement is frozen in at BUILD time (@AVBASE_WITH_FFMPEG@) so the
# package describes the tree it was made from instead of guessing.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The exported targets reference FFmpeg::* IMPORTED targets, and CMake has no
# built-in FindFFmpeg -- the module ships beside this file (see
# AvbaseInstall.cmake), so look here before the default module path.
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Threads is the only always-on dependency (base/task runs a TaskQueue per
# player thread; find_package(Threads) is REQUIRED in the top-level build).
find_dependency(Threads)

# A build with AVBASE_ENABLE_FFMPEG=ON exported avbase_ffmpeg's symbols, so
# the consumer needs the same FFmpeg components this build linked. A build
# with it OFF (the no-ffmpeg gate, design goal G2) needs nothing. libyuv
# travels with FFmpeg: avbase_ffmpeg's link interface names libyuv::libyuv
# (pixel conversion), and it is found by the module shipped beside this file.
if(@AVBASE_WITH_FFMPEG@)
  find_dependency(FFmpeg COMPONENTS avformat avcodec avutil swscale swresample
                             avfilter)
  find_dependency(Libyuv)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/avbaseTargets.cmake")

check_required_components(avbase)
